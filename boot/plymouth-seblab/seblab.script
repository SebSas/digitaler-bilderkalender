# ============================================================
#  SebLab Design — Plymouth Boot-Theme
#  Debian GNU/Linux 13 (trixie) / Raspberry Pi
# ============================================================

Window.SetBackgroundTopColor(0.788, 0.788, 0.800);
Window.SetBackgroundBottomColor(0.788, 0.788, 0.800);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

# ---------- Logo, zentriert, ~34% der Bildschirmbreite ----------
logo.raw = Image("logo.png");
logo.w = Math.Int(screen.w * 0.34);
logo.h = Math.Int(logo.raw.GetHeight() * logo.w / logo.raw.GetWidth());
logo.image = logo.raw.Scale(logo.w, logo.h);
logo.sprite = Sprite(logo.image);
logo.x = screen.w / 2 - logo.w / 2;
logo.y = screen.h / 2 - logo.h / 2 - Math.Int(screen.h * 0.05);
logo.sprite.SetPosition(logo.x, logo.y, 100);

# ---------- Lade-Punkte unterhalb des Logos ----------
NUM_DOTS = 5;
dot_on = Image("dot-on.png");
dot_off = Image("dot-off.png");
dot.spacing = dot_on.GetWidth() + 16;
dots.w = NUM_DOTS * dot.spacing - 16;
dots.x = screen.w / 2 - dots.w / 2;
dots.y = logo.y + logo.h + Math.Int(screen.h * 0.06);

for (i = 0; i < NUM_DOTS; i++) {
  dot_sprite[i] = Sprite(dot_off);
  dot_sprite[i].SetPosition(dots.x + i * dot.spacing, dots.y, 101);
}

counter = 0;

fun refresh_callback() {
  counter++;
  # Plymouth aktualisiert mit 50 Hz -> alle 6 Frames weiterschalten
  active = Math.Int(counter / 6) % NUM_DOTS;
  for (i = 0; i < NUM_DOTS; i++) {
    if (i == active)
      dot_sprite[i].SetImage(dot_on);
    else
      dot_sprite[i].SetImage(dot_off);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ---------- Statusmeldungen (fsck etc.) ----------
message_sprite = Sprite();
message_sprite.SetPosition(0, 0, 102);

fun message_callback(text) {
  msg = Image.Text(text, 0.086, 0.086, 0.094);
  message_sprite.SetImage(msg);
  message_sprite.SetPosition(screen.w / 2 - msg.GetWidth() / 2,
                             Math.Int(screen.h * 0.90), 102);
}
Plymouth.SetMessageFunction(message_callback);

# ---------- Passwortabfrage (z. B. LUKS) ----------
prompt_sprite = Sprite();
bullet_sprite = Sprite();

fun display_password_callback(prompt, bullets) {
  p = Image.Text(prompt, 0.086, 0.086, 0.094);
  prompt_sprite.SetImage(p);
  prompt_sprite.SetPosition(screen.w / 2 - p.GetWidth() / 2,
                            Math.Int(screen.h * 0.78), 103);

  stars = "";
  for (i = 0; i < bullets; i++)
    stars += "• ";
  b = Image.Text(stars, 0.086, 0.086, 0.094);
  bullet_sprite.SetImage(b);
  bullet_sprite.SetPosition(screen.w / 2 - b.GetWidth() / 2,
                            Math.Int(screen.h * 0.83), 103);
}

fun display_normal_callback() {
  prompt_sprite.SetImage(Image.Text("", 0, 0, 0));
  bullet_sprite.SetImage(Image.Text("", 0, 0, 0));
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---------- Sauberes Ende ----------
fun quit_callback() {
  for (i = 0; i < NUM_DOTS; i++)
    dot_sprite[i].SetImage(dot_off);
}
Plymouth.SetQuitFunction(quit_callback);
