[Unit]
Description=DBK Fan Control
After=pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=sebi
WorkingDirectory=/home/sebi/scripts

ExecStart=/usr/bin/python3 /home/sebi/scripts/temperature_control_app.py --poll-seconds 30

# Stop fan deterministically
ExecStop=/usr/bin/python3 /home/sebi/scripts/fan_off.py

TimeoutStopSec=5
KillSignal=SIGINT

Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
